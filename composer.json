{
    "name": "se7enxweb/sqliimport",
    "description": "7x SQLI Import for Exponential: imports content from CSV, XML, RSS and JSON sources (upload, URL or server file) through a no-code mapping or import handlers, run by the job queue in chunks with a log and a row per record, on demand or on schedules. Handlers of sqliimport 1.x keep working.",
    "keywords": [ "exponential", "exponential 6", "exponential-legacy", "legacy-extension", "import", "content import", "csv", "xml", "rss", "json", "mapping", "job queue", "cronjob", "migration" ],
    "homepage": "https://github.com/se7enxweb/sqliimport",
    "support": {
        "issues": "https://github.com/se7enxweb/sqliimport/issues",
        "source": "https://github.com/se7enxweb/sqliimport",
        "docs": "https://github.com/se7enxweb/sqliimport/tree/master/doc"
    },
    "type": "ezpublish-legacy-extension",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Jérôme Vieilledent",
            "email": "lolautruche@gmail.com",
            "role": "Original author"
        },
        {
            "name": "Simone Tellini",
            "homepage": "http://tellini.info/",
            "role": "Oracle support"
        },
        {
            "name": "7x",
            "email": "info@se7enx.com",
            "homepage": "https://se7enx.com",
            "role": "Maintainer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.0",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-xmlreader": "*",
        "ext-dom": "*",
        "se7enxweb/exponential-legacy-installer": "*",
        "se7enxweb/expqueue": "~0.1.5",
        "se7enxweb/expui": "^1.0.0.14"
    },
    "suggest": {
        "se7enxweb/expai": "Suggests mappings and explains failed rows (7x SQLI Import 2.1)",
        "openspout/openspout": "XLSX and ODS sources (a later 2.x release)",
        "ext-pcntl": "Lets the 1.x command line script sqlidoimport.php stop safely on SIGTERM or SIGINT",
        "ext-iconv": "Better slugs and name matching (transliteration)"
    },
    "replace": {
        "lolautruche/sqliimport": "self.version"
    },
    "extra": {
        "installer-name": "sqliimport",
        "ezpublish-legacy-extension-name": "sqliimport"
    }
}
