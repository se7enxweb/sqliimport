{
    "name": "se7enxweb/sqliimport",
    "description": "SQLI Import for Exponential: a framework and admin interface to import external content (XML, CSV, RSS, any source) into Exponential through import handlers, run immediately or on a schedule by a cronjob.",
    "keywords": [ "exponential", "exponential-legacy", "legacy-extension", "import", "content import", "csv", "xml", "rss", "cronjob", "migration" ],
    "homepage": "https://github.com/se7enxweb/sqliimport",
    "support": {
        "issues": "https://github.com/se7enxweb/sqliimport/issues",
        "source": "https://github.com/se7enxweb/sqliimport"
    },
    "type": "ezpublish-legacy-extension",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Jérôme Vieilledent",
            "email": "lolautruche@gmail.com",
            "role": "Original author"
        },
        {
            "name": "Simone Tellini",
            "homepage": "http://tellini.info/",
            "role": "Oracle support"
        },
        {
            "name": "7x",
            "email": "info@se7enx.com",
            "homepage": "https://se7enx.com",
            "role": "Maintainer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.0",
        "se7enxweb/exponential-legacy-installer": "*"
    },
    "suggest": {
        "ext-pcntl": "Lets a running import be interrupted safely with SIGTERM or SIGINT (kill -15, kill -2, Ctrl+C)",
        "ext-simplexml": "For XML sources read with SQLIXMLParser and the bundled RSS handler",
        "ext-dom": "For XML sources read with SQLIXMLParser in DOM mode"
    },
    "replace": {
        "lolautruche/sqliimport": "self.version"
    },
    "extra": {
        "installer-name": "sqliimport",
        "ezpublish-legacy-extension-name": "sqliimport"
    }
}
