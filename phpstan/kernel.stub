<?php
/**
 * Declarations of the kernel and extension types the 2.x code extends or implements, for PHPStan only (they come from
 * Exponential, ezcomponents and expqueue in an installation; this file is never loaded there).
 *
 * It is a .stub outside tests/ on purpose: an autoload generator or a test harness that reads the PHP files of an
 * extension, or of its tests directory, must never find these hollow classes. Loaded once in an installation they
 * stand in for the real eZPersistentObject, ezcBaseOptions, expSecrets ... and break everything that runs after it.
 * Not part of the Composer archive (.gitattributes).
 */
interface expAuditTaxonomyBranch { public function events(); }
interface expQueueHandler { public function run( expQueueJob $job, expQueueContext $context ); }
abstract class expQueueHandlerBase implements expQueueHandler { }
class expQueueJob { }
class expQueueContext { }
#[AllowDynamicProperties]
class eZPersistentObject { public function __construct( $row = null ) {} }
class ezcBaseException extends Exception { }
abstract class ezcBaseOptions implements ArrayAccess { protected $properties; }
class ezjscServerFunctions { }
// Exponential 6.0.15 (#691): the kernel secret store and the data table layer, used only behind class_exists()
class expSecrets
{
    /** @return string|null */
    public static function get( $ref, array $fallback = array() ) { return null; }
    /** @return array */
    public static function names( $scope = null ) { return array(); }
    /** @return string */
    public static function mask( $text, array $refs, array $values = array() ) { return ''; }
    /** @return bool */
    public static function installed( $fresh = false ) { return false; }
    /** @return bool */
    public static function validName( $name ) { return false; }
    /** @return bool */
    public static function set( $name, $value, $scope = '', $description = null ) { return false; }
}
interface expDataTableFieldSource
{
    public function dataTableSourceName();
    public function dataTableReferences();
    public function dataTableFields( array $options );
    public function dataTableSourceLabel( array $options );
}
class expDataTableWriter
{
    public function __construct( $class, array $options = array() ) {}
    /** @return array */
    public function write( array $rows ) { return array(); }
}
class expDataTableCatalogue
{
    /** @return expDataTableCatalogue */
    public static function instance() { return new self(); }
    /** @return array */
    public function classes() { return array(); }
}
class expDataSync
{
    /** @return bool */
    public static function installed() { return false; }
}
class expDataConnections
{
    /** @return array */
    public static function all() { return array(); }
    /** @return array|null */
    public static function get( $identifier ) { return null; }
    /** @return eZDBInterface */
    public static function db( $identifier ) { return eZDB::instance(); }
}
// the extension expai (Exponential Intelligence), used by the AI assist only behind class_exists()
interface expAiProvider
{
    public function send( array $request );
    public function modelName();
    public function providerId();
}
class expAiProviderRegistry
{
    /** @return expAiProvider */
    public function providerFor( $alias ) { throw new Exception(); }
}
class expAiConfig
{
    /** @return expAiConfig */
    public static function instance() { return new self(); }
    /** @return string */
    public function effectiveModel() { return ''; }
    /** @return bool */
    public function mayUseModel( $alias ) { return false; }
    /** @return expAiProviderRegistry */
    public function registry() { return new expAiProviderRegistry(); }
}
class expAiGate
{
    /** @return string */
    public static function switchedOff( ?expAiConfig $config = null, $siteAccess = null ) { return ''; }
}
class expAiDataPolicy
{
    /** @return expAiDataPolicy */
    public static function forProvider( expAiConfig $config, $providerID ) { return new self(); }
    public function assertClass( $classIdentifier, $sectionID ) {}
}
class expAiWebBudget
{
    public static function assertFits( $alias, $what = 'field', ?expAiConfig $config = null ) {}
}
class expAiBudget
{
    public function __construct( ?expAiConfig $config = null ) {}
    /** @return array */
    public function estimate( $alias, $inputTokens, $outputTokens, $lane = null ) { return array(); }
    /** @return int */
    public function estimateInputTokens( array $request ) { return 0; }
    /** @return array|null */
    public function refusal( $micros, $groupID = 0, $excludeJobID = 0 ) { return null; }
}
class expAiUsageRecorder implements expAiProvider
{
    public function __construct( expAiProvider $inner, array $context = array() ) {}
    public function send( array $request ) { return array(); }
    public function modelName() { return ''; }
    public function providerId() { return ''; }
}
class expAiText
{
    /** @return string */
    public static function stripReasoning( $text ) { return ''; }
}
